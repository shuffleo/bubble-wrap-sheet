{
  "name": "bubble-wrap",
  "version": "8.0.0",
  "private": true,
  "description": "A tactile bubble-wrap sheet with bundled recorded audio, keyboard popping, and sliding sheet exchanges.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.cjs tests/game/*.test.cjs",
    "dev": "node scripts/serve.mjs",
    "game:dev": "node scripts/game-dev.mjs",
    "serve": "node scripts/serve.mjs",
    "test:browser": "python3 tests/release_browser.py",
    "test:game-ui": "python3 tests/game_ui_browser.py",
    "atlas": "python3 scripts/build_atlas.py",
    "audio": "python3 scripts/process_audio.py",
    "social": "python3 scripts/make_social_assets.py && npm run build",
    "test:legacy": "python3 tests/interaction_check.py && python3 tests/touch_recovery_check.py",
    "test:react-syntax": "node scripts/check_react.mjs",
    "package": "python3 scripts/package_release.py"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.6",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "bootstrap": {
      "optional": true
    }
  }
}
